{
  "name": "@mizan/compose",
  "version": "0.1.0",
  "type": "module",
  "description": "One-source authorization acquisition and composition for Mizan",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
